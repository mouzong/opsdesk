# OpsDesk configuration. Copy to ".env" (git-ignored) - `npm start`, `npm run backup` and `npm run restore`
# read it automatically; with Docker Compose it is read by `docker compose`.
# Never commit a real .env and never put real credentials in this example file.

# ---- Network / data -------------------------------------------------------------------------------------
OPSDESK_PORT=4310
# OPSDESK_HOST=127.0.0.1
# OPSDESK_DATA_DIR=

# ---- Database engine: chosen at start-up only; changing it does NOT move data (see docs/OPERATIONS.md) ----
# Default. No external service needed.
OPSDESK_DB_CLIENT=sqlite
# OPSDESK_SQLITE_PATH=./data/opsdesk.sqlite        # default: <data dir>/opsdesk.sqlite

# PostgreSQL (>= 13):
# OPSDESK_DB_CLIENT=postgres
# OPSDESK_DATABASE_URL=postgres://opsdesk:CHANGE_ME@db.example.internal:5432/opsdesk
# MySQL (>= 8.0.16):
# OPSDESK_DB_CLIENT=mysql
# OPSDESK_DATABASE_URL=mysql://opsdesk:CHANGE_ME@db.example.internal:3306/opsdesk
# Percent-encode special characters in the password (@ -> %40, / -> %2F, : -> %3A).
# Alternative that keeps the URL out of the environment: OPSDESK_DATABASE_URL_FILE=/run/secrets/opsdesk_database_url

# TLS to PostgreSQL/MySQL. auto = on for remote hosts, off for localhost. Certificates are always verified.
# OPSDESK_DB_SSL=auto                               # auto | on | off
# OPSDESK_DB_SSL_CA_FILE=/path/to/internal-ca.pem   # private CA bundle (PEM)
# OPSDESK_DB_SSL_INSECURE_SKIP_VERIFY=1             # DANGEROUS, last resort, prints a warning at start-up

# Pool and timeouts (PostgreSQL/MySQL)
# OPSDESK_DB_POOL_MAX=5
# OPSDESK_DB_CONNECT_TIMEOUT_MS=10000
# OPSDESK_DB_QUERY_TIMEOUT_MS=15000

# ---- HTTP API for curl / scripts (see the documentation: API Reference > Authentication) ---------------------
# Server-side secret. Without it the API refuses every change from non-browser clients (the web UI is unaffected).
# 24-256 characters from A-Z a-z 0-9 . _ ~ + / = -        Generate one with:  npm run token:generate
# OPSDESK_API_TOKEN=
# OPSDESK_API_TOKEN_FILE=/run/secrets/opsdesk_api_token   # alternative: read the token from a file
# Exact browser origins allowed to call the API with the token (never a wildcard), e.g. the docs preview:
# OPSDESK_CORS_ORIGINS=http://127.0.0.1:8000
# Behind a TLS-terminating reverse proxy: honour X-Forwarded-Proto so tokens are accepted for non-local host names over HTTPS
# OPSDESK_TRUST_PROXY=1

# ---- Health endpoint (/api/health) ---------------------------------------------------------------------
# OPSDESK_HEALTH_TIMEOUT_MS=3000
# OPSDESK_HEALTH_CACHE_SECONDS=5

# ---- Docker Compose only (docker-compose.postgres.yml / docker-compose.mysql.yml) -----------------------
# Generate with:  openssl rand -hex 24      (hex avoids URL-encoding problems)
# POSTGRES_PASSWORD=
# MYSQL_PASSWORD=
# MYSQL_ROOT_PASSWORD=
