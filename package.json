{
  "name": "opsdesk",
  "version": "1.3.0",
  "description": "OpsDesk - a local, offline infrastructure bookmarks dashboard",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/clean.mjs dist/server dist/shared dist/web dist/build-info.json && tsc -p tsconfig.server.json && vite build && node scripts/build-info.mjs",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "backup": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/backup.mjs",
    "restore": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/restore.mjs",
    "archive": "node scripts/archive.mjs",
    "config:check": "tsx --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/cli/check-config.ts",
    "db:migrate": "tsx --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/cli/migrate.ts",
    "docs:setup": "node scripts/docs.mjs setup",
    "docs:build": "node scripts/docs.mjs build",
    "docs:serve": "node scripts/docs.mjs serve",
    "build:all": "npm run build && npm run docs:build",
    "api:spec": "tsx --disable-warning=ExperimentalWarning server/cli/api-spec.ts",
    "docs:vendor": "node scripts/vendor-swagger.mjs",
    "token:generate": "node scripts/token.mjs",
    "version": "npm run api:spec"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "busboy": "^1.6.0",
    "express": "^5.3.0",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.61.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@types/busboy": "^1.5.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "swagger-ui-dist": "^5.34.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
